{
  "name": "@notambourine/shopify-cli-condom",
  "version": "0.0.3",
  "description": "Development-only Shopify CLI wrapper for working on real stores.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notambourine/shopify-cli-condom.git"
  },
  "type": "module",
  "bin": {
    "shopify-cli-condom": "dist/bin/shopify-cli-condom.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "lint": "oxlint && lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity --validate-package-names",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && node scripts/bundle-platforms.ts"
  },
  "dependencies": {
    "@shopify/cli": "4.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "lockfile-lint": "^5.0.1",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  },
  "bundleDependencies": [
    "@shopify/cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
